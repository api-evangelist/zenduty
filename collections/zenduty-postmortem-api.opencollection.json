            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.zenduty.com/api/account/teams/{}/postmortem/",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              }
            ]
          },
          "docs": "Returns a list of Postmortem objects."
