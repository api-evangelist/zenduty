              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              },
              {
                "name": "sla_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the SLA object"
              }
            ]
