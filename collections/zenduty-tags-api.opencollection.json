{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zenduty Account Custom Role Tags API",
    "version": "1.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Tag objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.zenduty.com/api/account/teams/{}/tags/",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              }
            ]
          },
          "docs": "Returns a list of Tag objects. The Tag objects are sorted by creation_date, with the most recent Tag object appearing last."
        },
        {
          "info": {
            "name": "Create the Tag object",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.zenduty.com/api/account/teams/{}/tags/",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create the Tag object by setting the values of all the required parameters passed in the request body."
        },
        {
          "info": {
            "name": "Retrieve the Tag object",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.zenduty.com/api/account/teams/:team_id/tags/:tag_id/",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Tag object"
              }
            ]
          },
          "docs": "Retrieve the specified Tag object."
        },
        {
          "info": {
            "name": "Update the Tag object",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.zenduty.com/api/account/teams/:team_id/tags/:tag_id/",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Tag object"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the specified Tag object by setting the values of the parameters passed in the request body. Any parameters not provided will be left unchanged."
        },
        {
          "info": {
            "name": "Delete the Tag object",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.zenduty.com/api/account/teams/:team_id/tags/:tag_id/",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Tag object"
              }
            ]
          },
          "docs": "Delete the specified Tag object permanently."
        }
      ]
    }
  ],
  "bundled": true
}