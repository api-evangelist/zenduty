              {
                "name": "sla_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the SLA object"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the specified SLA object by setting the values of the parameters passed in the request body. Any parameters not provided will be left unchanged."
        },
        {
          "info": {
            "name": "Delete the SLA object",
