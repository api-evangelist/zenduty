{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zenduty Account Custom Role Incident Responders API",
    "version": "1.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Incident Responders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Incident Responders objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.zenduty.com/api/v2/incidents/:incident_number/responders/",
            "params": [
              {
                "name": "incident_number",
                "value": "",
                "type": "path",
                "description": "Incident number of the Incident object"
              }
            ]
          },
          "docs": "Returns a list of Incident Responders objects."
        },
        {
          "info": {
            "name": "Add an Incident Responder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.zenduty.com/api/v2/incidents/:incident_number/responders/",
            "params": [
              {
                "name": "incident_number",
                "value": "",
                "type": "path",
                "description": "Incident number of the Incident object"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add an Incident Responder to the incident"
        },
        {
          "info": {
            "name": "Retrieve an Incident Responder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.zenduty.com/api/incidents/:incident_number/responders/:unique_id/",
            "params": [
              {
                "name": "incident_number",
                "value": "",
                "type": "path",
                "description": "Incident number of the Incident object"
              },
              {
                "name": "unique_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Incident Responder Object"
              }
            ]
          },
          "docs": "Retrieve details of an Incident Responder"
        },
        {
          "info": {
            "name": "Delete an Incident Responder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://www.zenduty.com/api/incidents/:incident_number/responders/:unique_id/",
            "params": [
              {
                "name": "incident_number",
                "value": "",
                "type": "path",
                "description": "Incident number of the Incident object"
              },
              {
                "name": "unique_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Incident Responder Object"
              }
            ]
          },
          "docs": "Delete an Incident Responder from the incident"
        }
      ]
    }
  ],
  "bundled": true
}