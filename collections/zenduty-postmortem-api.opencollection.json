        {
          "info": {
            "name": "Create the Postmortem object",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.zenduty.com/api/account/teams/{}/postmortem/",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "unique_id of the Team object"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
